#!/bin/bash
# Run pytest from ~/dynamo inside the Dynamo SGLang runtime image.
#   dynamo-pytest tests/frontend/test_tool_calling_sglang.py -v -s
set -euo pipefail
[[ -f ~/.radix_env ]] && { set -a; source ~/.radix_env; set +a; }
IMAGE="${DYNAMO_SGLANG_IMAGE:-nvcr.io/nvidia/ai-dynamo/sglang-runtime:1.5.1}"
mkdir -p ~/hf
exec podman run --rm --device nvidia.com/gpu=all --ipc=host --network host \
  -v ~/dynamo:/workspace -v ~/hf:/root/.cache/huggingface -e HF_TOKEN \
  -w /workspace "$IMAGE" bash -lc '
    # Pytest plugins pinned by the repo, plus the light runtime deps tests import.
    grep -E "^pytest" container/deps/requirements.test.txt | sed "s/ *#.*//" > /tmp/req.txt
    pip install -q -r /tmp/req.txt nats-py==2.12.0 jsonschema psutil requests filelock 2>&1 | tail -1
    python3 -m pytest -p no:cacheprovider "$@"' _ "$@"
